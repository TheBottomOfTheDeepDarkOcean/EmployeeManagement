@model EmployeesManagement.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Assign User Rights";
}

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus"></i> Assign User Group Permission
    </a>
</p>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <form asp-action="UserGroupRights" method="post">
                <input type="hidden" name="Id" value="@Model.RoleId" />
                <table class="table table-striped table-bordered table-hover table-fixed-header">
                    <thead class="header" style="margin: 0px auto; width: 100%;">
                        <tr>
                            <th>Module</th>
                            <th>Feature</th>
                            <th>Actions</th>
                            <th>Assign Right</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Profiles != null)
                        {
                            @foreach (var module in Model.Profiles.Where(x => x.ProfileId == null))
                            {
                                @* Dòng hiển thị Tên Module chính *@
                                <tr class="bg-light font-weight-bold">
                                    <td colspan="8">
                                        <strong>@module.Name</strong>
                                    </td>
                                </tr>

                                @* Duyệt các Module con (Submodule / Feature) *@
                                @if (module.Children != null && module.Children.Any())
                                {
                                    @foreach (var submodule in module.Children)
                                    {
                                        <tr>
                                            <th></th> @* Cột Module trống để lùi lề Feature *@
                                            <td>
                                                <input type="hidden" name="RolesProfilesIds[]" value="@submodule.Id" />
                                                @submodule.Name
                                            </td>
                                        </tr>
                                        
                                            @foreach (var actions in submodule.Children)
                                            {
                                            <tr>
                                                <th></th>
                                                <th></th>
                                                <td>@actions.Name</td>
                                                <td>
                                                        @if(Model.RolesRightsIds.Contains(actions.Id))
                                                        {
                                                        <label><input type="checkbox" name="Ids[]" value="@actions.Id" checked="checked" /></label>
                                                        } else
                                                        {
                                                        <label><input type="checkbox" name="Ids[]" value="@actions.Id" /></label>

                                                        }

                                                </td>
                                            </tr>
                                            }
                                    }
                                }
                            }
                        }
                    </tbody>
                </table>
                <div class="form-group">
                    <div class="col-md-12">
                        <div class="card-footer">
                            <div class="clearfix">
                                <a asp-action="Index" class="btn btn-danger push-left">Back to List</a>
                                <input type="submit" value="Assign Rights" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>